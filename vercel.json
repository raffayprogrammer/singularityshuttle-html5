{
  "headers": [
    {
      "source": "/(.*)\\.swf",
      "headers": [
        { "key": "Content-Type", "value": "application/x-shockwave-flash" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/pages/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
